{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://www.myhomeschoolscribe.com/course-builder/format/hssweek.schema.json",
  "title": "HomeSchool Scribe Course Builder week (.hssweek), format 1.0",
  "description": "One file holding a family's planned week: color lanes (children by color, never by name), courses on days, and the lessons in each course. The app adds what is in it and never changes anything already there. Unknown fields at any level are allowed and ignored by the importer; unknown enum values fall back to the app default with a note. Children's names, birthdays, photos, the state, the school name, year dates, breaks, terms, goals, grading scale, grades earned, hours and attendance are never in this file.",
  "type": "object",
  "required": ["format", "formatVersion", "fileId", "createdAt", "updatedAt", "madeWith", "source", "schoolYear", "week", "lanes", "courses"],
  "properties": {
    "format": { "const": "homeschoolscribe.week" },
    "formatVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+$", "description": "MAJOR.MINOR. A minor bump adds optional fields only; a major bump is a breaking change the app refuses." },
    "fileId": { "$ref": "#/$defs/uuid" },
    "createdAt": { "$ref": "#/$defs/dateTime" },
    "updatedAt": { "$ref": "#/$defs/dateTime" },
    "madeWith": {
      "type": "object",
      "required": ["tool", "version"],
      "properties": {
        "tool": { "type": "string", "minLength": 1, "maxLength": 60 },
        "version": { "type": "string", "minLength": 1, "maxLength": 20 }
      }
    },
    "source": {
      "type": "object",
      "required": ["kind"],
      "properties": {
        "kind": { "type": "string", "enum": ["blank", "sample", "starterLink", "publisher", "coop", "returnedFile"] },
        "id": { "type": "string", "maxLength": 120 },
        "label": { "type": "string", "maxLength": 120 },
        "url": { "type": "string", "maxLength": 2000 }
      }
    },
    "schoolYear": {
      "type": "object",
      "required": ["startYear", "label"],
      "properties": {
        "startYear": { "type": "integer", "minimum": 2000, "maximum": 2100 },
        "label": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}$" }
      }
    },
    "week": {
      "type": "object",
      "required": ["days"],
      "properties": {
        "days": {
          "type": "array",
          "minItems": 1,
          "maxItems": 7,
          "items": {
            "type": "object",
            "required": ["day", "on"],
            "properties": {
              "day": { "$ref": "#/$defs/dayCode" },
              "on": { "type": "boolean" },
              "label": { "type": "string", "maxLength": 40 }
            }
          }
        }
      }
    },
    "lanes": { "type": "array", "minItems": 1, "maxItems": 6, "items": { "$ref": "#/$defs/lane" } },
    "courses": { "type": "array", "items": { "$ref": "#/$defs/course" } },
    "extensions": { "type": "object" }
  },
  "$defs": {
    "uuid": { "type": "string", "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$" },
    "dateTime": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?(Z|[+-][0-9]{2}:[0-9]{2})$" },
    "date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "hex6": { "type": "string", "pattern": "^[0-9a-fA-F]{6}$" },
    "dayCode": { "type": "string", "enum": ["sun", "mon", "tue", "wed", "thu", "fri", "sat"], "description": "sun=1 ... sat=7, the app's weekday numbers" },
    "laneColor": { "type": "string", "enum": ["blue", "green", "orange", "purple", "red", "teal"] },
    "subject": { "type": "string", "enum": ["Language Arts", "Math", "Science", "Social Studies", "Foreign Language", "Fine Arts", "PE & Health", "Bible & Religion", "Technology", "Life Skills", "Elective", "Other"], "description": "SubjectArea raw values" },
    "scheduleMode": { "type": "string", "enum": ["On the calendar", "Loop"], "description": "ScheduleMode raw values" },
    "gradingMode": { "type": "string", "enum": ["Points", "Grade I enter", "Pass/fail", "Narrative, no grade"], "description": "GradingMode raw values" },
    "level": { "type": "string", "enum": ["Regular", "Honors", "AP", "Dual enrollment"], "description": "CourseLevel raw values" },
    "resourceKind": { "type": "string", "enum": ["Book", "Curriculum", "Website", "Video", "Kit or supplies", "Other"], "description": "ResourceKind raw values" },
    "tag": { "type": "string", "enum": ["quiz", "test", "lab", "review", "graded"] },
    "lane": {
      "type": "object",
      "required": ["laneId", "color", "colorHex", "grade"],
      "properties": {
        "laneId": { "$ref": "#/$defs/uuid" },
        "color": { "$ref": "#/$defs/laneColor" },
        "colorHex": { "$ref": "#/$defs/hex6" },
        "grade": { "type": ["integer", "null"], "minimum": -1, "maximum": 12, "description": "GradeLevel raw value: -1 Pre-K, 0 K, 1 to 12. null is reserved for co-op packs (v2)." },
        "extensions": { "type": "object" }
      }
    },
    "course": {
      "type": "object",
      "required": ["courseId", "laneIds", "name", "subject", "scheduleMode", "days", "minutes", "gradingMode", "lessons"],
      "properties": {
        "courseId": { "$ref": "#/$defs/uuid" },
        "laneIds": { "type": "array", "minItems": 1, "maxItems": 6, "items": { "$ref": "#/$defs/uuid" } },
        "name": { "type": "string", "minLength": 1, "maxLength": 120 },
        "subject": { "$ref": "#/$defs/subject" },
        "colorHex": { "type": "string", "pattern": "^([0-9a-fA-F]{6})?$", "description": "Empty means the subject's default color." },
        "scheduleMode": { "$ref": "#/$defs/scheduleMode" },
        "days": { "type": "array", "maxItems": 7, "items": { "$ref": "#/$defs/dayCode" }, "description": "Required and non-empty for calendar courses; may be empty for a loop course (every school day)." },
        "minutes": { "type": "integer", "minimum": 5, "maximum": 240, "multipleOf": 5 },
        "startDate": { "oneOf": [{ "$ref": "#/$defs/date" }, { "type": "null" }] },
        "startAtLesson": { "type": "integer", "minimum": 1 },
        "spreadOverYear": { "type": "boolean" },
        "gradingMode": { "$ref": "#/$defs/gradingMode" },
        "level": { "$ref": "#/$defs/level" },
        "credits": { "type": "number", "enum": [0.25, 0.5, 1, 1.5, 2] },
        "includeOnTranscript": { "type": "boolean" },
        "targetHours": { "type": "number", "enum": [0, 120, 150, 180] },
        "curriculum": { "type": "string", "maxLength": 200 },
        "notes": { "type": "string", "maxLength": 4000 },
        "resources": { "type": "array", "items": { "$ref": "#/$defs/resource" } },
        "categories": { "type": "array", "items": { "$ref": "#/$defs/category" } },
        "lessons": { "type": "array", "maxItems": 200, "items": { "$ref": "#/$defs/lesson" } },
        "extensions": { "type": "object" }
      }
    },
    "resource": {
      "type": "object",
      "required": ["resourceId", "title"],
      "properties": {
        "resourceId": { "$ref": "#/$defs/uuid" },
        "title": { "type": "string", "minLength": 1, "maxLength": 200 },
        "author": { "type": "string", "maxLength": 200 },
        "isbn": { "type": "string", "maxLength": 20 },
        "kind": { "$ref": "#/$defs/resourceKind" },
        "url": { "type": "string", "maxLength": 2000 },
        "notes": { "type": "string", "maxLength": 4000 }
      }
    },
    "category": {
      "type": "object",
      "required": ["categoryId", "name", "weight"],
      "properties": {
        "categoryId": { "$ref": "#/$defs/uuid" },
        "name": { "type": "string", "minLength": 1, "maxLength": 60 },
        "weight": { "type": "number", "minimum": 0, "maximum": 100 }
      }
    },
    "lesson": {
      "type": "object",
      "required": ["lessonId", "title"],
      "properties": {
        "lessonId": { "$ref": "#/$defs/uuid" },
        "title": { "type": "string", "minLength": 1, "maxLength": 200 },
        "details": { "type": "string", "maxLength": 4000, "description": "What to do. The child sees it in Student Mode, with Read aloud." },
        "minutes": { "oneOf": [{ "type": "integer", "minimum": 5, "maximum": 240 }, { "type": "null" }], "description": "null means the course's minutes." },
        "unit": { "type": ["string", "null"], "maxLength": 120, "description": "Kept for the site; the app has no unit field. The site writes the unit into the title." },
        "tags": { "type": "array", "items": { "$ref": "#/$defs/tag" } },
        "pointsPossible": { "oneOf": [{ "type": "number", "exclusiveMinimum": 0 }, { "type": "null" }], "description": "Required when tags include graded; default 100." },
        "categoryId": { "oneOf": [{ "$ref": "#/$defs/uuid" }, { "type": "null" }] },
        "include": { "type": "boolean", "description": "false = an unticked row, kept so a returning file remembers it; not imported." },
        "extensions": { "type": "object" }
      }
    }
  }
}
